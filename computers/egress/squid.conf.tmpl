# Rendered by entrypoint.sh. Policy: public internet only, ports 80/443, no caching, no identity
# headers. Squid resolves names itself, so a DNS answer that points at a private address is refused
# exactly like a literal private address (clients never connect to anything but this proxy).

http_port @BROWSER_IP@:3128 name=browser
http_port @BACKEND_IP@:3128 name=backend
http_port @SANDBOX_IP@:3128 name=sandbox
http_port @MCP_IP@:3128 name=mcphost
http_port 127.0.0.1:3130 name=health

acl browser_port myportname browser
acl backend_port myportname backend
acl sandbox_port myportname sandbox
acl mcp_port myportname mcphost

# mcp-host: every MCP server (and every install) logs in as its own proxy user and may reach only the
# hosts in its allow-list. Both are files mcp-host writes into @MCP_DIR@ (read-only here); the helpers
# read them on every lookup, so there is nothing to reload. Answers are cached briefly: a removed
# login or host stops working within 30 seconds (logins) or 10 seconds (hosts).
auth_param basic program /usr/local/bin/egress-mcp-auth @MCP_DIR@
auth_param basic children 4 startup=1 idle=1
auth_param basic realm clarity-egress
auth_param basic credentialsttl 30 seconds
auth_param basic casesensitive on
acl mcp_login proxy_auth REQUIRED
external_acl_type mcp_allow ttl=10 negative_ttl=0 children-max=4 children-startup=1 %LOGIN %DST /usr/local/bin/egress-mcp-allow @MCP_DIR@
acl mcp_allowed external mcp_allow

# Never reachable, however the name is spelled or resolved. (IPv4-mapped IPv6 such as ::ffff:10.0.0.1
# is normalised to IPv4 by Squid, so the IPv4 ranges cover it; listing ::ffff:0:0/96 would match all IPv4.)
acl private_dst dst 0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 127.0.0.0/8 169.254.0.0/16
acl private_dst dst 172.16.0.0/12 192.0.0.0/24 192.168.0.0/16 198.18.0.0/15 224.0.0.0/4 240.0.0.0/4
acl private_dst dst ::/128 ::1/128 fc00::/7 fe80::/10 ff00::/8 64:ff9b::/96 2002::/16
acl private_name dstdomain localhost localhost.localdomain host.containers.internal host.docker.internal gateway.docker.internal
acl private_regex dstdom_regex -i \.local$ \.localhost$ \.internal$ \.lan$ \.home\.arpa$

acl web_ports port 80 443
acl tls_port port 443
acl CONNECT method CONNECT
acl backend_hosts dstdomain @BACKEND_ALLOW@

http_access deny !browser_port !backend_port !sandbox_port !mcp_port
http_access deny private_dst
http_access deny private_name
http_access deny private_regex
http_access deny !web_ports
http_access deny CONNECT !tls_port
# no login (or a wrong one) gets a 407 challenge; a login only its own hosts
http_access deny mcp_port !mcp_login
http_access allow mcp_port mcp_allowed
http_access deny mcp_port
http_access allow backend_port backend_hosts
http_access deny backend_port
http_access allow browser_port
http_access allow sandbox_port
http_access deny all

# No caching, no identity headers, no version banner.
cache deny all
cache_mem 8 MB
forwarded_for delete
# No Via either way. `via off` does the same but Squid 6+ warns "HTTP requires the use of Via" at
# every start; stripping the header keeps the proxy just as invisible without the warning. (Via is
# for loop detection between proxies; this is the only one, and it never reaches itself: its
# listeners are on private addresses, which private_dst refuses.)
via on
request_header_access Via deny all
reply_header_access Via deny all
httpd_suppress_version_string on
visible_hostname egress

# Everything lives on tmpfs; logs go to the container's stdout/stderr. The healthcheck only opens
# and closes a TCP connection to the health listener (`error:transaction-end-before-headers`), so
# loopback is left out of the access log; real clients only ever come from the client networks.
pid_filename none
cache_log stdio:/dev/stderr
acl from_loopback src 127.0.0.0/8
access_log stdio:/dev/stdout !from_loopback
coredump_dir /tmp
logfile_rotate 0
max_filedescriptors 4096
shutdown_lifetime 2 seconds
# (No `dns_v4_first`: removed in Squid 5, ignored since. Squid connects to IPv4 and IPv6 addresses
# Happy Eyeballs style, so a host whose IPv6 route is broken still works over IPv4.)
