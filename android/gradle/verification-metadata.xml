<?xml version="1.0" encoding="UTF-8"?>
<!--
  Gradle dependency verification for the Android build. Only the sherpa-onnx AAR is checked: it comes
  from a GitHub release (see settings.gradle.kts), not a Maven repository with its own checksums, so
  its SHA-256 is pinned here. Everything else is trusted as before (the regex matches every group
  except com.k2fsa.sherpa.onnx).

  To bump sherpa-onnx: change the version in gradle/libs.versions.toml and the sha256 below to the
  digest GitHub lists for sherpa-onnx-static-link-onnxruntime-<version>.aar on the release page.
-->
<verification-metadata xmlns="https://schema.gradle.org/dependency-verification"
                       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                       xsi:schemaLocation="https://schema.gradle.org/dependency-verification https://schema.gradle.org/dependency-verification/dependency-verification-1.3.xsd">
   <configuration>
      <verify-metadata>false</verify-metadata>
      <verify-signatures>false</verify-signatures>
      <trusted-artifacts>
         <trust group="^(?!com[.]k2fsa[.]sherpa[.]onnx$).*$" regex="true"/>
      </trusted-artifacts>
   </configuration>
   <components>
      <component group="com.k2fsa.sherpa.onnx" name="sherpa-onnx-static-link-onnxruntime" version="1.13.8">
         <artifact name="sherpa-onnx-static-link-onnxruntime-1.13.8.aar">
            <sha256 value="b22c3fc1b6a45666d28892bb2f7694beeb77a8362d7ebd77c1a5431ec9435471" origin="GitHub release v1.13.8 asset digest, checked locally"/>
         </artifact>
      </component>
   </components>
</verification-metadata>
