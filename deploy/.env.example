# Copy to deploy/.env and pass with:  podman compose --env-file deploy/.env -f deploy/compose.yaml up -d

# Image tag for ghcr.io/robog-two/clarity-* (latest | sha-<short> | main)
#CLARITY_TAG=latest

# Interface the backend's plain-HTTP port is published on. Keep loopback; clients use Caddy (TLS) below.
#CLARITY_BIND=127.0.0.1

# TLS (Caddy). localhost/IPs/*.local: Caddy's own local CA. A public DNS name: Let's Encrypt via ACME.
#CLARITY_DOMAIN=localhost
# Several names, comma separated. A name with your own certificate in deploy/secrets/<name>.pem + .key
# (e.g. a Cloudflare Origin Certificate) uses it instead of ACME; see deploy/README.md.
#CLARITY_DOMAIN="clarity.example.com, clarity.example.net"
# Address Caddy listens on: [::] (default, IPv6), 0.0.0.0 (IPv4 only), or one specific address
#CLARITY_PUBLIC_BIND=[::]
#CLARITY_HTTP_PORT=80
#CLARITY_HTTPS_PORT=443

# tofu: first device to enroll wins while no device exists. token: always require the enrollment token.
#CLARITY_ENROLLMENT_MODE=tofu

# Dev only: accept connector data without approval in the app.
#CLARITY_CONNECTORS_AUTO_GRANT=false

# Agent
#CLARITY_AGENT_MODEL=claude-opus-5-5
#CLARITY_AGENT_EFFORT=medium
#CLARITY_REVIEW_INTERVAL=2h

# OpenRouter for any role, e.g. the guard and triage (one-shot calls). Also add openrouter.ai to
# CLARITY_BACKEND_EGRESS_ALLOW below. Model names are OpenRouter's. The lead may run there too
# (CLARITY_AGENT_LEAD_PROVIDER=openrouter): it then compacts its thread itself at
# CLARITY_AGENT_LEAD_COMPACT_AT_TOKENS, its main cost lever there (no prompt cache).
#OPENROUTER_API_KEY=sk-or-...
#CLARITY_AGENT_GUARD_PROVIDER=openrouter
#CLARITY_AGENT_GUARD_MODEL=anthropic/claude-haiku-5.5
#CLARITY_AGENT_TRIAGE_PROVIDER=openrouter
#CLARITY_AGENT_TRIAGE_MODEL=anthropic/claude-haiku-5.5

# Tools reachable by the agent. With `--profile computers` (sandbox + Firefox browser) use:
#CLARITY_MCP_SERVERS=sandbox=http://sandbox:8940/mcp;keyFile=/run/secrets/sandbox_key,browser=http://browser:8931/mcp;keyFile=/run/secrets/browser_key
# Format: name=url[;keyFile=/path/to/bearer-key], comma-separated. Without keyFile no key is sent.

# Example connector poll cadence
#CLARITY_EXAMPLE_SYNC_INTERVAL=1m

# Mail connector poll cadence (IDLE keeps it near-instant where the server supports it)
#CLARITY_MAIL_SYNC_INTERVAL=30s
# Calendar, contacts and files connector poll cadence
#CLARITY_DAV_SYNC_INTERVAL=5m

# Extra hosts the backend may reach through the egress proxy besides api.anthropic.com
# (comma separated; a leading dot allows subdomains). Must resolve to public addresses.
#CLARITY_BACKEND_EGRESS_ALLOW=
